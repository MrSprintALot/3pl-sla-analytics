// ================================================================
// 3PL LOGISTICS SLA PERFORMANCE ANALYTICS
// DAX Measure Library — claude_bi_test
// Semantic Model v1.0  |  FY 2025  |  101 Measures  |  7 Folders
// ================================================================
//
// FOLDERS:
//   0. Filters & Context   — Period slicer KPIs
//   1. Core KPIs           — SLA Breach Rate, OTD%, Late Deliveries
//   2. Cost                — Breach cost, CPD, recoverable savings
//   3. Time Intelligence   — MoM, YTD, Rolling 3M, role-playing dates
//   4. Rankings            — RANKX carrier/warehouse/region
//   5. Service Level       — Express vs Standard, delay severity bands
//   6. KPI Cards & Format  — HTML visuals, conditional colors, labels
//
// DATE STRATEGY:
//   Active:   fact_deliveries[delivered_date] → dim_date[date]
//   Inactive: promised_date, order_date, ship_date (USERELATIONSHIP)
// ================================================================


// ================================================================
// 0. FILTERS & CONTEXT  (8 measures)
// ================================================================

// ── 'Period Date Filter' ──
measure 'Period Date Filter' =
VAR SelectedPeriod = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
VAR StartDate =
SWITCH(
SelectedPeriod,
"Q1 2025", DATE(2025, 1, 1),
"Q2 2025", DATE(2025, 4, 1),
"Q3 2025", DATE(2025, 7, 1),
"Q4 2025", DATE(2025, 10, 1),
DATE(2025, 1, 1)
)
VAR EndDate =
SWITCH(
SelectedPeriod,
"Q1 2025", DATE(2025, 3, 31),
"Q2 2025", DATE(2025, 6, 30),
"Q3 2025", DATE(2025, 9, 30),
"Q4 2025", DATE(2025, 12, 31),
DATE(2025, 12, 31)
)
RETURN
IF(
MIN(dim_date[date]) >= StartDate && MAX(dim_date[date]) <= EndDate,
1, 0
)
formatString: #,0
displayFolder: 0. Filters & Context

/// Total deliveries scoped to the dim_period slicer selection. Use this on KPI cards and visuals where period filtering is required.

// ── 'Total Deliveries (Period)' ──
measure 'Total Deliveries (Period)' =
VAR SelectedPeriod = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
VAR StartDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,1,1),
"Q2 2025", DATE(2025,4,1),
"Q3 2025", DATE(2025,7,1),
"Q4 2025", DATE(2025,10,1),
DATE(2025,1,1)
)
VAR EndDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,3,31),
"Q2 2025", DATE(2025,6,30),
"Q3 2025", DATE(2025,9,30),
"Q4 2025", DATE(2025,12,31),
DATE(2025,12,31)
)
RETURN
CALCULATE(
[Total Deliveries],
dim_date[date] >= StartDate,
dim_date[date] <= EndDate
)
formatString: #,0
displayFolder: 0. Filters & Context

/// Late deliveries scoped to the dim_period slicer selection.

// ── 'Late Deliveries (Period)' ──
measure 'Late Deliveries (Period)' =
VAR SelectedPeriod = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
VAR StartDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,1,1),
"Q2 2025", DATE(2025,4,1),
"Q3 2025", DATE(2025,7,1),
"Q4 2025", DATE(2025,10,1),
DATE(2025,1,1)
)
VAR EndDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,3,31),
"Q2 2025", DATE(2025,6,30),
"Q3 2025", DATE(2025,9,30),
"Q4 2025", DATE(2025,12,31),
DATE(2025,12,31)
)
RETURN
CALCULATE(
[Late Deliveries],
dim_date[date] >= StartDate,
dim_date[date] <= EndDate
)
formatString: #,0
displayFolder: 0. Filters & Context

/// SLA Breach Rate scoped to the dim_period slicer selection. Use this as the primary KPI card measure — it respects the Period filter slicer.

// ── 'SLA Breach Rate (Period)' ──
measure 'SLA Breach Rate (Period)' =
DIVIDE(
[Late Deliveries (Period)],
[Total Deliveries (Period)]
)
formatString: 0.0%
displayFolder: 0. Filters & Context

/// On-Time Delivery % scoped to the dim_period slicer selection.

// ── 'On-Time Delivery % (Period)' ──
measure 'On-Time Delivery % (Period)' = 1 - [SLA Breach Rate (Period)]
formatString: 0.0%
displayFolder: 0. Filters & Context

/// Cost of late deliveries scoped to the dim_period slicer selection.

// ── 'Cost of SLA Breaches (Period)' ──
measure 'Cost of SLA Breaches (Period)' =
VAR SelectedPeriod = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
VAR StartDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,1,1),
"Q2 2025", DATE(2025,4,1),
"Q3 2025", DATE(2025,7,1),
"Q4 2025", DATE(2025,10,1),
DATE(2025,1,1)
)
VAR EndDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,3,31),
"Q2 2025", DATE(2025,6,30),
"Q3 2025", DATE(2025,9,30),
"Q4 2025", DATE(2025,12,31),
DATE(2025,12,31)
)
RETURN
CALCULATE(
[Cost of SLA Breaches],
dim_date[date] >= StartDate,
dim_date[date] <= EndDate
)
formatString: $#,0
displayFolder: 0. Filters & Context

/// Average delay days (late deliveries only) scoped to the dim_period slicer selection.

// ── 'Avg Delay Days (Period)' ──
measure 'Avg Delay Days (Period)' =
VAR SelectedPeriod = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
VAR StartDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,1,1),
"Q2 2025", DATE(2025,4,1),
"Q3 2025", DATE(2025,7,1),
"Q4 2025", DATE(2025,10,1),
DATE(2025,1,1)
)
VAR EndDate =
SWITCH(SelectedPeriod,
"Q1 2025", DATE(2025,3,31),
"Q2 2025", DATE(2025,6,30),
"Q3 2025", DATE(2025,9,30),
"Q4 2025", DATE(2025,12,31),
DATE(2025,12,31)
)
RETURN
CALCULATE(
[Avg Delay Days],
dim_date[date] >= StartDate,
dim_date[date] <= EndDate
)
formatString: 0.0
displayFolder: 0. Filters & Context

/// Returns the currently selected period label for use in KPI card subtitles and report titles.

// ── 'Period Label' ──
measure 'Period Label' = SELECTEDVALUE(dim_period[Period], "Full Year 2025")
formatString: @
displayFolder: 0. Filters & Context

/// Dynamic subtitle for the SLA Breach Rate KPI card. Shows target threshold and pp deviation. Period-aware.


// ================================================================
// 1. CORE KPIS  (8 measures)
// ================================================================

// ── 'Total Deliveries' ──
measure 'Total Deliveries' =
CALCULATE(
COUNTROWS(fact_deliveries),
TREATAS(
VALUES(dim_date[date]),
fact_deliveries[delivered_date]
)
)
formatString: #,0
displayFolder: 1. Core KPIs

/// Count of late deliveries (is_late = 1). Scoped to delivered_date within dim_date range — eliminates (Blank) axis entries.

// ── 'Late Deliveries' ──
measure 'Late Deliveries' =
CALCULATE(
SUM(fact_deliveries[is_late]),
TREATAS(
VALUES(dim_date[date]),
fact_deliveries[delivered_date]
)
)
formatString: #,0
displayFolder: 1. Core KPIs

/// Count of deliveries delivered on or before promised_date.

// ── 'On-Time Deliveries' ──
measure 'On-Time Deliveries' = [Total Deliveries] - [Late Deliveries]
formatString: #,0
displayFolder: 1. Core KPIs

/// Proportion of deliveries that breached SLA. Business target: < 10%. Formula: Late Deliveries / Total Deliveries.

// ── 'SLA Breach Rate' ──
measure 'SLA Breach Rate' = DIVIDE([Late Deliveries], [Total Deliveries])
formatString: 0.0%
displayFolder: 1. Core KPIs

/// Proportion of deliveries fulfilled within the promised delivery date. Complement of SLA Breach Rate.

// ── 'On-Time Delivery %' ──
measure 'On-Time Delivery %' = 1 - [SLA Breach Rate]
formatString: 0.0%
displayFolder: 1. Core KPIs

/// Average delay in days, calculated only over late deliveries. Excludes on-time deliveries to avoid diluting severity signal.

// ── 'Avg Delay Days' ──
measure 'Avg Delay Days' =
AVERAGEX(
FILTER(fact_deliveries, fact_deliveries[delay_days] > 0),
fact_deliveries[delay_days]
)
formatString: 0.0
displayFolder: 1. Core KPIs

/// Total cumulative delay days across all late shipments. Useful for severity-weighted comparisons.

// ── 'Total Delay Days' ──
measure 'Total Delay Days' =
SUMX(
FILTER(fact_deliveries, fact_deliveries[delay_days] > 0),
fact_deliveries[delay_days]
)
formatString: #,0
displayFolder: 1. Core KPIs

/// Total shipping cost across all deliveries in context. Includes both on-time and late shipments.

// ── 'Fleet Avg Breach Rate' ──
measure 'Fleet Avg Breach Rate' =

CALCULATE(
[SLA Breach Rate],
ALL(dim_carrier)
)
displayFolder: 1. Core KPIs


/// Spread between the worst-ranked (R1) and best-ranked (R5) carrier SLA Breach Rate. Measures how dispersed carrier performance is. A large gap signals that top carriers are dragging the fleet average up significantly.


// ================================================================
// 2. COST  (11 measures)
// ================================================================

// ── 'Total Shipping Cost' ──
measure 'Total Shipping Cost' = SUM(fact_deliveries[shipping_cost_usd])
formatString: "$"#,0.00
displayFolder: 2. Cost

/// Total shipping cost attributable to late deliveries. Represents the financial exposure from SLA non-compliance.

// ── 'Cost of SLA Breaches' ──
measure 'Cost of SLA Breaches' =
CALCULATE(
SUM(fact_deliveries[shipping_cost_usd]),
fact_deliveries[is_late] = 1
)
formatString: "$"#,0.00
displayFolder: 2. Cost

/// Total shipping cost for deliveries fulfilled within SLA.

// ── 'Cost of On-Time Deliveries' ──
measure 'Cost of On-Time Deliveries' =
CALCULATE(
SUM(fact_deliveries[shipping_cost_usd]),
fact_deliveries[is_late] = 0
)
formatString: "$"#,0.00
displayFolder: 2. Cost

/// Proportion of total shipping spend that was incurred on late deliveries. Cost-weighted SLA exposure metric.

// ── 'SLA Breach Cost %' ──
measure 'SLA Breach Cost %' = DIVIDE([Cost of SLA Breaches], [Total Shipping Cost])
formatString: 0.0%
displayFolder: 2. Cost

/// Average shipping cost per delivery in current context.

// ── 'Avg Cost per Delivery' ──
measure 'Avg Cost per Delivery' = DIVIDE([Total Shipping Cost], [Total Deliveries])
formatString: "$"#,0.00
displayFolder: 2. Cost

/// Average shipping cost per late delivery. Useful for benchmarking carrier cost-efficiency against SLA performance.

// ── 'Avg Cost per Late Delivery' ──
measure 'Avg Cost per Late Delivery' =
DIVIDE(
[Cost of SLA Breaches],
[Late Deliveries]
)
formatString: "$"#,0.00
displayFolder: 2. Cost

/// SLA Breach Rate for the prior month. Uses active promised_date relationship.

// ── 'Total Shipping Cost (K)' ──
measure 'Total Shipping Cost (K)' = "$" & FORMAT(ROUND([Total Shipping Cost] / 1000, 0), "#,0") & "K"
formatString: @
displayFolder: 2. Cost

/// Short-format label for Cost of On-Time Deliveries. Renders as e.g. '$458K'.

// ── 'Cost of On-Time Deliveries (K)' ──
measure 'Cost of On-Time Deliveries (K)' = "$" & FORMAT(ROUND([Cost of On-Time Deliveries] / 1000, 0), "#,0") & "K"
formatString: @
displayFolder: 2. Cost

/// Short-format label for Cost of SLA Breaches. Renders as e.g. '$102K'.

// ── 'Cost of SLA Breaches (K)' ──
measure 'Cost of SLA Breaches (K)' = "$" & FORMAT(ROUND([Cost of SLA Breaches] / 1000, 0), "#,0") & "K"
formatString: @
displayFolder: 2. Cost

/// Estimated cost recoverable if the fleet SLA Breach Rate were reduced to the 10% target. Calculated as: (Current Breach Rate - 10% target) * Total Deliveries * Avg Cost per Delivery. Represents the financial opportunity of closing the SLA gap. Renders as '~$XXK' to signal it is an estimate.

// ── 'Recoverable Cost at 10pct Target' ──
measure 'Recoverable Cost at 10pct Target' =
VAR CurrentBreachRate = [SLA Breach Rate]
VAR TargetBreachRate  = 0.10
VAR ExcessBreachRate  = CurrentBreachRate - TargetBreachRate
VAR TotalDeliveries   = [Total Deliveries]
VAR AvgCost           = [Avg Cost per Delivery]
VAR RecoverableAmt    = ExcessBreachRate * TotalDeliveries * AvgCost
RETURN
IF(
ExcessBreachRate > 0,
"~$" & FORMAT(ROUND(RecoverableAmt / 1000, 0), "#,0") & "K",
"On Target"
)
formatString: @
displayFolder: 2. Cost

/// Multi-line active filter summary for the bottom-left filter status panel. Shows current Carrier, Period, and Region selections. Uses UNICHAR(10) for line breaks inside a Card visual.

// ── 'Cost per Delivery' ──
measure 'Cost per Delivery' = DIVIDE([Total Shipping Cost], [Total Deliveries], 0)
formatString: $#,0.00
displayFolder: 2. Cost

/// Returns hex color per delay_day_label bucket. Blue=Minor(1-3d), Amber=Moderate(4-7d), Red=Severe(8d+). Use as conditional formatting field value on Delay Severity bar chart.


// ================================================================
// 3. TIME INTELLIGENCE  (10 measures)
// ================================================================

// ── 'SLA Breach Rate PM' ──
measure 'SLA Breach Rate PM' =
CALCULATE(
[SLA Breach Rate],
DATEADD(dim_date[date], -1, MONTH)
)
formatString: 0.0%
displayFolder: 3. Time Intelligence

/// Month-over-month change in SLA Breach Rate (percentage points). Positive = worsening. Negative = improving.

// ── 'SLA Breach Rate MoM Δ' ──
measure 'SLA Breach Rate MoM Δ' =
VAR CurrentRate = [SLA Breach Rate]
VAR PriorRate    = [SLA Breach Rate PM]
RETURN
IF(
NOT ISBLANK(PriorRate),
CurrentRate - PriorRate,
BLANK()
)
formatString: +0.0%;-0.0%;0.0%
displayFolder: 3. Time Intelligence

/// Cumulative late deliveries from Jan 1 to last date in current filter context.

// ── 'Late Deliveries YTD' ──
measure 'Late Deliveries YTD' =
CALCULATE(
[Late Deliveries],
DATESYTD(dim_date[date])
)
formatString: #,0
displayFolder: 3. Time Intelligence

/// Cumulative total deliveries YTD. Use with Late Deliveries YTD for running SLA breach rate.

// ── 'Total Deliveries YTD' ──
measure 'Total Deliveries YTD' =
CALCULATE(
[Total Deliveries],
DATESYTD(dim_date[date])
)
formatString: #,0
displayFolder: 3. Time Intelligence

/// Year-to-date SLA breach rate. Anchored on promised_date via active relationship.

// ── 'SLA Breach Rate YTD' ──
measure 'SLA Breach Rate YTD' =
DIVIDE(
[Late Deliveries YTD],
[Total Deliveries YTD]
)
formatString: 0.0%
displayFolder: 3. Time Intelligence

/// Cumulative cost of late deliveries from Jan 1 to current date in context.

// ── 'Cost of SLA Breaches YTD' ──
measure 'Cost of SLA Breaches YTD' =
CALCULATE(
[Cost of SLA Breaches],
DATESYTD(dim_date[date])
)
formatString: "$"#,0.00
displayFolder: 3. Time Intelligence

/// Rolling 3-month late delivery count. Smooths short-term spikes for trend analysis.

// ── 'Late Deliveries Rolling 3M' ──
measure 'Late Deliveries Rolling 3M' =
CALCULATE(
[Late Deliveries],
DATESINPERIOD(dim_date[date], LASTDATE(dim_date[date]), -3, MONTH)
)
formatString: #,0
displayFolder: 3. Time Intelligence

/// SLA Breach Rate evaluated via order_date instead of delivered_date. Activates inactive relationship.

// ── 'SLA Breach Rate by Order Date' ──
measure 'SLA Breach Rate by Order Date' =
CALCULATE(
[SLA Breach Rate],
USERELATIONSHIP(fact_deliveries[order_date], dim_date[date])
)
formatString: 0.0%
displayFolder: 3. Time Intelligence

/// SLA Breach Rate via delivered_date. Now uses ACTIVE relationship — no USERELATIONSHIP needed. This is the default date context for the report.

// ── 'SLA Breach Rate by Delivered Date' ──
measure 'SLA Breach Rate by Delivered Date' = [SLA Breach Rate]
formatString: 0.0%
displayFolder: 3. Time Intelligence

/// Ranks carriers 1-N by SLA Breach Rate descending (1 = worst performer). Uses DENSE ranking to handle ties. ALLSELECTED respects slicer context.

// ── 'SLA Breach Rate by Promised Date' ──
measure 'SLA Breach Rate by Promised Date' =
CALCULATE(
[SLA Breach Rate],
USERELATIONSHIP(fact_deliveries[promised_date], dim_date[date])
)
formatString: 0.0%
displayFolder: 3. Time Intelligence



// ================================================================
// 4. RANKINGS  (13 measures)
// ================================================================

// ── 'Carrier SLA Rank' ──
measure 'Carrier SLA Rank' =
IF(
HASONEVALUE(dim_carrier[carrier_name]),
RANKX(
ALLSELECTED(dim_carrier[carrier_name]),
[SLA Breach Rate],
,
DESC,
DENSE
),
BLANK()
)
formatString: #,0
displayFolder: 4. Rankings

/// Ranks regions by SLA Breach Rate descending. Rank 1 = highest breach rate.

// ── 'Region SLA Rank' ──
measure 'Region SLA Rank' =
IF(
HASONEVALUE(dim_region[country]),
RANKX(
ALLSELECTED(dim_region[country]),
[SLA Breach Rate],
,
DESC,
DENSE
),
BLANK()
)
formatString: #,0
displayFolder: 4. Rankings

/// Ranks warehouses by SLA Breach Rate descending. Identifies dispatch bottlenecks.

// ── 'Warehouse SLA Rank' ──
measure 'Warehouse SLA Rank' =
IF(
HASONEVALUE(dim_warehouse[warehouse_name]),
RANKX(
ALLSELECTED(dim_warehouse[warehouse_name]),
[SLA Breach Rate],
,
DESC,
DENSE
),
BLANK()
)
formatString: #,0
displayFolder: 4. Rankings

/// Returns 1 for the carrier with the highest SLA breach rate. Used to drive conditional formatting in visuals.

// ── 'Is Worst Carrier Flag' ──
measure 'Is Worst Carrier Flag' =
VAR CurrentRank = [Carrier SLA Rank]
RETURN
IF(CurrentRank = 1, 1, 0)
formatString: #,0
displayFolder: 4. Rankings

/// Carrier SLA breach rate delta vs the fleet average. Positive = underperforming vs peers. Negative = outperforming.

// ── 'Carrier vs Avg Breach Rate' ──
measure 'Carrier vs Avg Breach Rate' =
VAR CarrierRate = [SLA Breach Rate]
VAR AvgRate     = CALCULATE([SLA Breach Rate], ALLSELECTED(dim_carrier[carrier_name]))
RETURN
IF(
HASONEVALUE(dim_carrier[carrier_name]),
CarrierRate - AvgRate,
BLANK()
)
formatString: +0.0%;-0.0%;0.0%
displayFolder: 4. Rankings

/// Returns 1 for carriers ranked in the Top N worst SLA performers. N is hardcoded to 3 — adjust for dynamic what-if parameter integration.

// ── 'Top N Carrier Breach Filter' ──
measure 'Top N Carrier Breach Filter' =
VAR N = 3
RETURN
IF([Carrier SLA Rank] <= N, 1, 0)
formatString: #,0
displayFolder: 4. Rankings

/// SLA Breach Rate restricted to Express-tier deliveries. Express carries higher SLA expectations and premium cost.

// ── 'SLA Worst Month Value' ──
measure 'SLA Worst Month Value' =

VAR MaxValue =
MAXX(
ALLSELECTED(dim_date[year_month_sort]),
[SLA Breach Rate by Delivered Date]
)
RETURN
MaxValue
displayFolder: 4. Rankings



// ── 'SLA Best Month Value' ──
measure 'SLA Best Month Value' =

VAR MinValue =
MINX(
ALLSELECTED(dim_date[year_month_sort]),
[SLA Breach Rate by Delivered Date]
)
RETURN
MinValue
displayFolder: 4. Rankings



// ── 'Carrier Gap R1-R5' ──
measure 'Carrier Gap R1-R5' =
VAR BestRate  = MINX(ALL(dim_carrier[carrier_name]), [SLA Breach Rate])
VAR WorstRate = MAXX(ALL(dim_carrier[carrier_name]), [SLA Breach Rate])
RETURN
IF(
NOT ISBLANK(BestRate) && NOT ISBLANK(WorstRate),
WorstRate - BestRate,
BLANK()
)
formatString: +0.0%;-0.0%;0.0%
displayFolder: 4. Rankings

/// Text label identifying the single worst-performing carrier × region lane by SLA Breach Rate. Format: 'CarrierName × RegionName XX.X%'. Used in visual footers and KPI card subtitles to surface the most critical operational lane at a glance.

// ── 'Worst Lane Label' ──
measure 'Worst Lane Label' =
VAR LaneTable =
ADDCOLUMNS(
CROSSJOIN(
ALL(dim_carrier[carrier_name]),
ALL(dim_region[country])
),
"LaneRate", CALCULATE([SLA Breach Rate])
)
VAR MaxRate =
MAXX(LaneTable, [LaneRate])
VAR WorstRow =
TOPN(
1,
LaneTable,
[LaneRate],
DESC
)
VAR WorstCarrier = MAXX(WorstRow, dim_carrier[carrier_name])
VAR WorstRegion  = MAXX(WorstRow, dim_region[country])
RETURN
IF(
NOT ISBLANK(MaxRate),
WorstCarrier & " × " & WorstRegion & " " & FORMAT(MaxRate, "0.0%"),
BLANK()
)
formatString: @
displayFolder: 4. Rankings

/// Composite footer string for the carrier performance table. Combines fleet average breach rate, R1-R5 gap in percentage points, and the worst carrier×region lane. Drop into a card visual positioned below the carrier table.

// ── 'Is Worst Warehouse Flag' ──
measure 'Is Worst Warehouse Flag' =
VAR CurrentRank = [Warehouse SLA Rank]
RETURN
IF(CurrentRank = 1, 1, 0)
formatString: #,0
displayFolder: 4. Rankings

/// Returns 1 for the warehouse with the lowest SLA breach rate. Used for green conditional formatting on best performer.

// ── 'Is Best Warehouse Flag' ──
measure 'Is Best Warehouse Flag' =
VAR CurrentRank = [Warehouse SLA Rank]
VAR MaxRank = COUNTROWS(ALLSELECTED(dim_warehouse[warehouse_name]))
RETURN
IF(CurrentRank = MaxRank, 1, 0)
formatString: #,0
displayFolder: 4. Rankings

/// Returns 1 for the carrier with the lowest SLA breach rate. Complements Is Worst Carrier Flag for BEST tag formatting.

// ── 'Is Best Carrier Flag' ──
measure 'Is Best Carrier Flag' =
VAR CurrentRank = [Carrier SLA Rank]
VAR MaxRank = COUNTROWS(ALLSELECTED(dim_carrier[carrier_name]))
RETURN
IF(CurrentRank = MaxRank, 1, 0)
formatString: #,0
displayFolder: 4. Rankings

/// Hex color for warehouse rows. Rank 1 = red, last rank = green, others = neutral grey. Apply via conditional formatting.


// ================================================================
// 5. SERVICE LEVEL  (13 measures)
// ================================================================

// ── 'Express SLA Breach Rate' ──
measure 'Express SLA Breach Rate' =
CALCULATE(
[SLA Breach Rate],
fact_deliveries[service_level] = "Express"
)
formatString: 0.0%
displayFolder: 5. Service Level

/// SLA Breach Rate restricted to Standard-tier deliveries.

// ── 'Standard SLA Breach Rate' ──
measure 'Standard SLA Breach Rate' =
CALCULATE(
[SLA Breach Rate],
fact_deliveries[service_level] = "Standard"
)
formatString: 0.0%
displayFolder: 5. Service Level

/// Difference in breach rate between Express and Standard. Positive = Express underperforms Standard, which is operationally critical.

// ── 'Express vs Standard Breach Delta' ──
measure 'Express vs Standard Breach Delta' =
VAR ExpressRate  = [Express SLA Breach Rate]
VAR StandardRate = [Standard SLA Breach Rate]
RETURN
IF(
NOT ISBLANK(ExpressRate) && NOT ISBLANK(StandardRate),
ExpressRate - StandardRate,
BLANK()
)
formatString: +0.0%;-0.0%;0.0%
displayFolder: 5. Service Level

/// Count of Express-tier deliveries.

// ── 'Express Deliveries' ──
measure 'Express Deliveries' = CALCULATE([Total Deliveries], fact_deliveries[service_level] = "Express")
formatString: #,0
displayFolder: 5. Service Level

/// Count of Standard-tier deliveries.

// ── 'Standard Deliveries' ──
measure 'Standard Deliveries' = CALCULATE([Total Deliveries], fact_deliveries[service_level] = "Standard")
formatString: #,0
displayFolder: 5. Service Level

/// Count of late deliveries delayed 1 to 3 days. Minor breach band — recoverable through process optimization.

// ── 'Delay Band 1-3 Days' ──
measure 'Delay Band 1-3 Days' =
CALCULATE(
[Late Deliveries],
fact_deliveries[delay_days] >= 1 && fact_deliveries[delay_days] <= 3
)
formatString: #,0
displayFolder: 5. Service Level

/// Count of late deliveries delayed 4 to 7 days. Moderate breach band — likely indicates route or carrier issues.

// ── 'Delay Band 4-7 Days' ──
measure 'Delay Band 4-7 Days' =
CALCULATE(
[Late Deliveries],
fact_deliveries[delay_days] >= 4 && fact_deliveries[delay_days] <= 7
)
formatString: #,0
displayFolder: 5. Service Level

/// Count of late deliveries delayed 8 or more days. Severe breach band — highest client impact and escalation risk.

// ── 'Delay Band 8+ Days' ──
measure 'Delay Band 8+ Days' =
CALCULATE(
[Late Deliveries],
fact_deliveries[delay_days] >= 8
)
formatString: #,0
displayFolder: 5. Service Level

/// Text label for SLA status. Green ≤ 10%, Amber ≤ 15%, Red > 15%. Now period-aware via SLA Breach Rate (Period).

// ── 'Delay Band 1-3 Pct' ──
measure 'Delay Band 1-3 Pct' = DIVIDE([Delay Band 1-3 Days], [Late Deliveries], 0)
formatString: 0.0%
displayFolder: 5. Service Level

/// Percentage of late deliveries in the Moderate severity band (4-7 days). Used in delay severity legend.

// ── 'Delay Band 4-7 Pct' ──
measure 'Delay Band 4-7 Pct' = DIVIDE([Delay Band 4-7 Days], [Late Deliveries], 0)
formatString: 0.0%
displayFolder: 5. Service Level

/// Percentage of late deliveries in the Severe severity band (8+ days). Used in delay severity legend.

// ── 'Delay Band 8+ Pct' ──
measure 'Delay Band 8+ Pct' = DIVIDE([Delay Band 8+ Days], [Late Deliveries], 0)
formatString: 0.0%
displayFolder: 5. Service Level

/// Returns 1 for the warehouse with the highest SLA breach rate. Mirrors Is Worst Carrier Flag for warehouse conditional formatting.

// ── 'Express Late Deliveries' ──
measure 'Express Late Deliveries' = CALCULATE([Late Deliveries], fact_deliveries[service_level] = "Express")
formatString: #,0
displayFolder: 5. Service Level

/// Count of late Standard-tier deliveries. Used in Service Level comparison panel.

// ── 'Standard Late Deliveries' ──
measure 'Standard Late Deliveries' = CALCULATE([Late Deliveries], fact_deliveries[service_level] = "Standard")
formatString: #,0
displayFolder: 5. Service Level

/// Average shipping cost per delivery (all deliveries). Key efficiency KPI — required on both Page 1 KPI strip and Page 2 cost summary.


// ================================================================
// 6. KPI CARDS & FORMATTING  (37 measures)
// ================================================================

// ── 'KPI SLA Status' ──
measure 'KPI SLA Status' =
VAR BreachRate = [SLA Breach Rate (Period)]
RETURN
SWITCH(
TRUE(),
BreachRate <= 0.10, "✅ On Target",
BreachRate <= 0.15, "⚠️ At Risk",
"🔴 Breaching"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Hex color for SLA status badge. Now period-aware via SLA Breach Rate (Period).

// ── 'KPI SLA Color' ──
measure 'KPI SLA Color' =

VAR BreachRate = [SLA Breach Rate (Period)]
RETURN
IF(
ISBLANK(BreachRate),
"#3E454F",
SWITCH(
TRUE(),
BreachRate <= 0.10, "#2EC27E",   -- brand green
BreachRate <= 0.15, "#F5B301",   -- your chosen gold
"#E8402A"                        -- brand red
)
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Human-readable MoM trend label for KPI card subtitles. e.g. ▲ 1.2% vs prior month.

// ── 'MoM Trend Label' ──
measure 'MoM Trend Label' =
VAR Delta = [SLA Breach Rate MoM Δ]
RETURN
IF(
ISBLANK(Delta),
"N/A",
IF(Delta > 0,
"▲ " & FORMAT(ABS(Delta), "0.0%") & " vs prior month",
IF(Delta < 0,
"▼ " & FORMAT(ABS(Delta), "0.0%") & " vs prior month",
"→ No change vs prior month"
)
)
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Passthrough of SLA Breach Rate used as the value input for conditional formatting rules on matrix/table visuals.

// ── 'Breach Rate CF Value' ──
measure 'Breach Rate CF Value' = [SLA Breach Rate]
formatString: 0.0%
displayFolder: 6. KPI Cards & Formatting

/// Dynamic label showing active slicer selections. Use as a card visual title to provide filter context to executives reading exports.

// ── 'Selected Filters Label' ──
measure 'Selected Filters Label' =
VAR CarrierSel  = SELECTEDVALUE(dim_carrier[carrier_name], "All Carriers")
VAR RegionSel   = SELECTEDVALUE(dim_region[country], "All Regions")
VAR SvcLvlSel   = SELECTEDVALUE(fact_deliveries[service_level], "All Levels")
RETURN
CarrierSel & " | " & RegionSel & " | " & SvcLvlSel
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Translates dim_period slicer selection into a boolean filter over dim_date. Use inside CALCULATE([Measure], [Period Date Filter]) to make any measure period-aware. Returns 1 for dates within the selected period, 0 otherwise.

// ── 'KPI SLA Subtitle' ──
measure 'KPI SLA Subtitle' =
VAR BreachRate = [SLA Breach Rate (Period)]
VAR Target = 0.10
VAR Delta = BreachRate - Target
VAR DeltaLabel = FORMAT(ABS(Delta * 100), "0.0") & "pp"
VAR Direction = IF(Delta > 0, "+" & DeltaLabel & " over target", "-" & DeltaLabel & " under target")
RETURN
"Target < 10.0%   ·   " & Direction
formatString: @
displayFolder: 6. KPI Cards & Formatting


// ── 'KPI On-Time Subtitle' ──
measure 'KPI On-Time Subtitle' =

FORMAT([On-Time Deliveries], "#,0") &
" on-time of " &
FORMAT([Total Deliveries (Period)], "#,0")
displayFolder: 6. KPI Cards & Formatting


// ── 'Late Deliveries Subtitle' ──
measure 'Late Deliveries Subtitle' =

"SLA breach events · " & [Period Label]
displayFolder: 6. KPI Cards & Formatting


// ── 'Avg Delay Subtitle' ──
measure 'Avg Delay Subtitle' =

"When late · Max observed: " &
FORMAT(
MAX(fact_deliveries[delay_days]),
"0"
) & "d"
displayFolder: 6. KPI Cards & Formatting


// ── 'Cost Breach Subtitle' ──
measure 'Cost Breach Subtitle' =

FORMAT([SLA Breach Cost %], "0.0%")
& " of "
& FORMAT([Total Shipping Cost], "$#,0,," & "K")
& " total spend"
displayFolder: 6. KPI Cards & Formatting


// ── 'KPI On-Time Color' ──
measure 'KPI On-Time Color' =

VAR OnTime = [On-Time Delivery % (Period)]
RETURN
IF(
ISBLANK(OnTime),
"#3E454F",
SWITCH(
TRUE(),
OnTime >= 0.90, "#2EC27E",
OnTime >= 0.85, "#F5B301",
"#E8402A"
)
)
displayFolder: 6. KPI Cards & Formatting


// ── 'KPI Late Deliveries Color' ──
measure 'KPI Late Deliveries Color' =

[KPI SLA Color]
displayFolder: 6. KPI Cards & Formatting

/// SLA Breach Rate evaluated via promised_date — shows breach rate of what was due in a given period. Uses USERELATIONSHIP since promised_date relationship is now inactive.

// ── 'Active Date Label' ──
measure 'Active Date Label' = "ACTIVE DATE: DELIVERED DATE"
displayFolder: 6. KPI Cards & Formatting


// ── 'SLA Marker Color' ──
measure 'SLA Marker Color' =

VAR CurrentValue = [SLA Breach Rate by Delivered Date]
VAR MaxValue = [SLA Worst Month Value]
VAR MinValue = [SLA Best Month Value]

RETURN
SWITCH(
TRUE(),
CurrentValue = MaxValue, "#F5B301",      -- Worst month = gold
CurrentValue = MinValue, "#2EC27E",      -- Best month = green
"#E8402A"                                -- Default red
)
displayFolder: 6. KPI Cards & Formatting


// ── 'Carrier Table Footer' ──
measure 'Carrier Table Footer' =
VAR FleetAvg  = [SLA Breach Rate]
VAR GapPP     = [Carrier Gap R1-R5]
VAR WorstLane = [Worst Lane Label]
RETURN
"Fleet avg: " & FORMAT(FleetAvg, "0.0%") &
"  ·  Gap R1–R5: " & FORMAT(GapPP * 100, "0.0") & "pp" &
"  ·  Worst lane: " & WorstLane
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Hex color for the Regional SLA Breach Rate bar chart. Gradient from bright red (rank 1) to dark warm brown (rank 4), matching the brand dark theme. Apply via conditional formatting on the bar data color field.

// ── 'Region Bar Color' ──
measure 'Region Bar Color' =
SWITCH(
[Region SLA Rank],
1, "#E8402A",
2, "#C0392B",
3, "#7B3A2A",
4, "#5C2B1E",
"#3E454F"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting


// ── 'Region Late Count Color' ──
measure 'Region Late Count Color' =
SWITCH(
[Region SLA Rank],
1, "#E8402A",
2, "#F5B301",
"#6B7280"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting


// ── 'Late Deliveries Label' ──
measure 'Late Deliveries Label' =

FORMAT([Late Deliveries], "#,0") & UNICHAR(10) & "late"
displayFolder: 6. KPI Cards & Formatting


// ── 'Active Filters Label' ──
measure 'Active Filters Label' =
VAR CarrierSel = SELECTEDVALUE(dim_carrier[carrier_name], "All")
VAR PeriodSel  = SELECTEDVALUE(dim_period[Period], "FY 2025")
VAR RegionSel  = SELECTEDVALUE(dim_region[country], "All")
RETURN
"Carrier: " & CarrierSel & UNICHAR(10) &
"Period: "  & PeriodSel  & UNICHAR(10) &
"Region: "  & RegionSel
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Percentage of late deliveries in the Minor severity band (1-3 days). Used in delay severity legend.

// ── 'Warehouse SLA Color' ──
measure 'Warehouse SLA Color' =
VAR _Rank = [Warehouse SLA Rank]
VAR _MaxRank = COUNTROWS(ALLSELECTED(dim_warehouse[warehouse_name]))
RETURN
SWITCH(
TRUE(),
_Rank = 1, "#E8402A",
_Rank = _MaxRank, "#2EC27E",
"#A0A5AF"
)
displayFolder: 6. KPI Cards & Formatting

/// Count of late Express-tier deliveries. Used in Service Level comparison panel.

// ── 'Delay Bar Color' ──
measure 'Delay Bar Color' =
VAR _label = SELECTEDVALUE(fact_deliveries[delay_day_label])
RETURN
SWITCH(
_label,
"1d", "#5B9BD5",
"2d", "#5B9BD5",
"3d", "#7AB4E8",
"4d", "#E6A817",
"5d", "#E6A817",
"6d", "#E6A817",
"7d", "#E6A817",
"8d+", "#E8402A",
"#5B9BD5"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Badge text for Delay Severity chart header. Shows late delivery count in the style of the reference design.

// ── 'Delay Chart Badge' ──
measure 'Delay Chart Badge' = "LATE DELIVERIES ONLY (" & FORMAT([Late Deliveries], "#,0") & ")"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Single-line legend text for Delay Severity chart. Shows count and % for each severity band. Drop as a Card visual below the chart.

// ── 'Delay Legend Label' ──
measure 'Delay Legend Label' =
"Minor 1-3d: " & FORMAT([Delay Band 1-3 Days], "#,0") & " (" & FORMAT([Delay Band 1-3 Pct], "0.0%") & ")     " &
"Moderate 4-7d: " & FORMAT([Delay Band 4-7 Days], "#,0") & " (" & FORMAT([Delay Band 4-7 Pct], "0.0%") & ")     " &
"Severe 8d+: " & FORMAT([Delay Band 8+ Days], "#,0") & " (" & FORMAT([Delay Band 8+ Pct], "0.0%") & ")"
formatString: @
displayFolder: 6. KPI Cards & Formatting


// ── 'Legend Minor Label' ──
measure 'Legend Minor Label' = "Minor 1-3d: " & FORMAT([Delay Band 1-3 Days], "#,0") & " (" & FORMAT([Delay Band 1-3 Pct], "0.0%") & ")"
formatString: @
displayFolder: 6. KPI Cards & Formatting


// ── 'Legend Moderate Label' ──
measure 'Legend Moderate Label' = "Moderate 4-7d: " & FORMAT([Delay Band 4-7 Days], "#,0") & " (" & FORMAT([Delay Band 4-7 Pct], "0.0%") & ")"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Legend card text for Severe band. Place next to a red rectangle shape.

// ── 'Legend Severe Label' ──
measure 'Legend Severe Label' = "Severe 8d+: " & FORMAT([Delay Band 8+ Days], "#,0") & " (" & FORMAT([Delay Band 8+ Pct], "0.0%") & ")"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Avg delay days with 'd' suffix for table display. e.g. '4.6d'. Use in Warehouse and Carrier tables instead of raw Avg Delay Days.

// ── 'Avg Delay Days Label' ──
measure 'Avg Delay Days Label' = FORMAT([Avg Delay Days], "0.0") & "d"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Font color for BREACH % column in warehouse table. Red=rank1, Amber=rank2, Green=last rank, Grey=middle.

// ── 'Warehouse Breach Rate Color' ──
measure 'Warehouse Breach Rate Color' =
VAR _Rank = [Warehouse SLA Rank]
VAR _MaxRank = COUNTROWS(ALLSELECTED(dim_warehouse[warehouse_name]))
RETURN
SWITCH(
TRUE(),
_Rank = 1, "#E8402A",
_Rank = 2, "#E6A817",
_Rank = _MaxRank, "#2EC27E",
"#A0A5AF"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Service level summary line for Standard tier. e.g. '8,176 del · 1,473 late'

// ── 'Standard SL Label' ──
measure 'Standard SL Label' = FORMAT([Standard Deliveries], "#,0") & " del  ·  " & FORMAT([Standard Late Deliveries], "#,0") & " late"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Service level summary line for Express tier. e.g. '1,025 del · 191 late'

// ── 'Express SL Label' ──
measure 'Express SL Label' = FORMAT([Express Deliveries], "#,0") & " del  ·  " & FORMAT([Express Late Deliveries], "#,0") & " late"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Formatted delta label for Express vs Standard breach rate. e.g. '+0.8pp Express > Standard'

// ── 'Express vs Standard Label' ──
measure 'Express vs Standard Label' =
VAR _delta = [Express vs Standard Breach Delta]
VAR _abs = ABS(_delta) * 100
VAR _dir = IF(_delta > 0, " Express > Standard", " Standard > Express")
RETURN
IF(
NOT ISBLANK(_delta),
"+" & FORMAT(_abs, "0.0") & "pp" & _dir,
BLANK()
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Breach cost label for Standard tier. e.g. '$73.3K breach cost'. Use as subtitle card in Service Level panel.

// ── 'Standard Breach Cost Label' ──
measure 'Standard Breach Cost Label' = "$" & FORMAT(ROUND(CALCULATE([Cost of SLA Breaches], fact_deliveries[service_level] = "Standard") / 1000, 1), "0.0") & "K breach cost"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Breach cost label for Express tier. e.g. '$29.2K breach cost'. Use as subtitle card in Service Level panel.

// ── 'Express Breach Cost Label' ──
measure 'Express Breach Cost Label' = "$" & FORMAT(ROUND(CALCULATE([Cost of SLA Breaches], fact_deliveries[service_level] = "Express") / 1000, 1), "0.0") & "K breach cost"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Font color for carrier name column in ranking table. Red=rank1 (worst), Green=last rank (best), Amber=rank2, Grey=middle.

// ── 'Carrier Name Color' ──
measure 'Carrier Name Color' =
VAR _Rank = [Carrier SLA Rank]
VAR _MaxRank = COUNTROWS(ALLSELECTED(dim_carrier[carrier_name]))
RETURN
SWITCH(
TRUE(),
_Rank = 1, "#E8402A",
_Rank = 2, "#E6A817",
_Rank = _MaxRank, "#2EC27E",
"#A0A5AF"
)
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Full HTML layout for Service Level & Cost panel. 544x416px. Segoe UI throughout.

// ── 'Service Level Cost HTML' ──
measure 'Service Level Cost HTML' =
VAR _stdRate = FORMAT([Standard SLA Breach Rate], "0.0%")
VAR _expRate = FORMAT([Express SLA Breach Rate], "0.0%")
VAR _stdDel = FORMAT([Standard Deliveries], "#,0")
VAR _stdLate = FORMAT([Standard Late Deliveries], "#,0")
VAR _expDel = FORMAT([Express Deliveries], "#,0")
VAR _expLate = FORMAT([Express Late Deliveries], "#,0")
VAR _stdCost = "$" & FORMAT(ROUND(CALCULATE([Cost of SLA Breaches], fact_deliveries[service_level] = "Standard") / 1000, 1), "0.0") & "K breach cost"
VAR _expCost = "$" & FORMAT(ROUND(CALCULATE([Cost of SLA Breaches], fact_deliveries[service_level] = "Express") / 1000, 1), "0.0") & "K breach cost"
VAR _delta = FORMAT(ABS([Express vs Standard Breach Delta]) * 100, "0.0")
VAR _totalCost = [Cost of SLA Breaches (K)]
VAR _cpd = "$" & FORMAT([Avg Cost per Late Delivery], "#,0.00")
VAR _rec = [Recoverable Cost at 10pct Target]
RETURN
"<style>*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif;}body,html{width:100%;height:100%;background:#0D0F14;}</style>" &
"<div style='width:100%;min-height:416px;background:#0D0F14;padding:14px 16px;display:flex;flex-direction:column;gap:10px;'>" &
"<div style='font-size:10px;font-weight:700;color:#A0A5AF;letter-spacing:2px;'>SERVICE LEVEL &amp; COST</div>" &
"<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;'>" &
"<div style='padding:12px 14px;background:#13161E;border-radius:6px;border-top:3px solid #A0A5AF;'>" &
"<div style='font-size:9px;font-weight:600;color:#A0A5AF;letter-spacing:1px;margin-bottom:5px;'>STANDARD</div>" &
"<div style='font-size:26px;font-weight:700;color:#FFFFFF;line-height:1;margin-bottom:6px;'>" & _stdRate & "</div>" &
"<div style='font-size:9px;color:#3E454F;margin-bottom:2px;'>" & _stdDel & " del &nbsp;&middot;&nbsp; " & _stdLate & " late</div>" &
"<div style='font-size:9px;color:#3E454F;'>" & _stdCost & "</div>" &
"</div>" &
"<div style='padding:12px 14px;background:#13161E;border-radius:6px;border-top:3px solid #E8402A;'>" &
"<div style='font-size:9px;font-weight:600;color:#A0A5AF;letter-spacing:1px;margin-bottom:5px;'>EXPRESS</div>" &
"<div style='font-size:26px;font-weight:700;color:#E8402A;line-height:1;margin-bottom:6px;'>" & _expRate & "</div>" &
"<div style='font-size:9px;color:#3E454F;margin-bottom:2px;'>" & _expDel & " del &nbsp;&middot;&nbsp; " & _expLate & " late</div>" &
"<div style='font-size:9px;color:#3E454F;'>" & _expCost & "</div>" &
"</div>" &
"</div>" &
"<div style='padding:8px 12px;background:#1A1400;border:1px solid #E6A817;border-radius:6px;display:flex;justify-content:space-between;align-items:center;'>" &
"<span style='font-size:10px;font-weight:700;color:#E6A817;'>+" & _delta & "pp &nbsp; Express &gt; Standard</span>" &
"<span style='font-size:9px;color:#5A5040;font-style:italic;'>&#9651; routing issue</span>" &
"</div>" &
"<div style='border-top:1px solid #1E2330;padding-top:9px;'>" &
"<div style='font-size:9px;font-weight:700;color:#A0A5AF;letter-spacing:1px;margin-bottom:8px;'>COST IMPACT</div>" &
"<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;'>" &
"<div style='padding:10px 12px;background:#13161E;border-radius:6px;'>" &
"<div style='font-size:8px;color:#3E454F;margin-bottom:4px;'>Total Breach Cost</div>" &
"<div style='font-size:18px;font-weight:700;color:#E8402A;'>" & _totalCost & "</div>" &
"</div>" &
"<div style='padding:10px 12px;background:#13161E;border-radius:6px;'>" &
"<div style='font-size:8px;color:#3E454F;margin-bottom:4px;'>Cost per Delivery</div>" &
"<div style='font-size:18px;font-weight:700;color:#E8402A;'>" & _cpd & "</div>" &
"</div>" &
"<div style='padding:10px 12px;background:#13161E;border-radius:6px;'>" &
"<div style='font-size:8px;color:#3E454F;margin-bottom:4px;'>Recoverable</div>" &
"<div style='font-size:18px;font-weight:700;color:#2EC27E;'>" & _rec & "</div>" &
"</div>" &
"</div>" &
"</div>" &
"<div style='margin-top:auto;padding:8px 12px;background:#0A1A0A;border:1px solid #1A4A1A;border-radius:6px;display:flex;align-items:center;gap:8px;'>" &
"<div style='width:6px;height:6px;border-radius:50%;background:#2EC27E;flex-shrink:0;'></div>" &
"<span style='font-size:9px;color:#2EC27E;font-style:italic;'>Closing the SLA gap to 10% target = " & _rec & " recoverable annually</span>" &
"</div>" &
"</div>"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Full HTML layout for Actions & Recommendations panel. 1703x151px. 5 cards. Segoe UI throughout.

// ── 'Actions Recommendations HTML' ──
measure 'Actions Recommendations HTML' =
"<style>*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif;}body,html{width:100%;height:100%;background:#0D0F14;}</style>" &
"<div style='width:100%;min-height:151px;background:#0D0F14;padding:10px 16px;display:flex;flex-direction:column;gap:8px;'>" &
"<div style='display:flex;justify-content:space-between;align-items:center;'>" &
"<span style='font-size:10px;font-weight:700;color:#A0A5AF;letter-spacing:2px;'>ACTIONS &amp; RECOMMENDATIONS</span>" &
"<span style='font-size:9px;color:#3E454F;font-style:italic;'>DERIVED FROM PAGE ANALYSIS</span>" &
"</div>" &
"<div style='display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr;gap:8px;flex:1;'>" &
"<div style='padding:9px 11px;background:#13161E;border-radius:5px;border-left:3px solid #E8402A;display:flex;flex-direction:column;gap:3px;'>" &
"<div style='display:flex;align-items:center;gap:6px;'>" &
"<span style='background:#E8402A;color:#fff;font-size:8px;font-weight:700;padding:1px 6px;border-radius:2px;'>REC 01</span>" &
"<span style='font-size:8px;color:#A0A5AF;letter-spacing:1px;'>OPERATIONAL</span>" &
"</div>" &
"<div style='font-size:10px;font-weight:700;color:#FFFFFF;'>Rebalance volume off RayoLog</div>" &
"<div style='font-size:8px;color:#A0A5AF;line-height:1.4;'>RayoLog &times; Mexico at 22.2% is the highest-volume failure lane. Shift 20% of Mexico allocation to CondorShip &mdash; est. $5.1K savings/yr.</div>" &
"</div>" &
"<div style='padding:9px 11px;background:#13161E;border-radius:5px;border-left:3px solid #E6A817;display:flex;flex-direction:column;gap:3px;'>" &
"<div style='display:flex;align-items:center;gap:6px;'>" &
"<span style='background:#E6A817;color:#13161E;font-size:8px;font-weight:700;padding:1px 6px;border-radius:2px;'>REC 02</span>" &
"<span style='font-size:8px;color:#A0A5AF;letter-spacing:1px;'>OPERATIONAL</span>" &
"</div>" &
"<div style='font-size:10px;font-weight:700;color:#FFFFFF;'>Root-cause 8d+ delay cluster</div>" &
"<div style='font-size:8px;color:#A0A5AF;line-height:1.4;'>301 severe delays (14.2%) concentrated in 8&ndash;10d range. Audit Mexico routing logic &mdash; likely last-mile handoff or customs clearance bottleneck.</div>" &
"</div>" &
"<div style='padding:9px 11px;background:#13161E;border-radius:5px;border-left:3px solid #E6A817;display:flex;flex-direction:column;gap:3px;'>" &
"<div style='display:flex;align-items:center;gap:6px;'>" &
"<span style='background:#E6A817;color:#13161E;font-size:8px;font-weight:700;padding:1px 6px;border-radius:2px;'>REC 03</span>" &
"<span style='font-size:8px;color:#A0A5AF;letter-spacing:1px;'>OPERATIONAL</span>" &
"</div>" &
"<div style='font-size:10px;font-weight:700;color:#FFFFFF;'>Audit WH-LIM-01 dispatch ops</div>" &
"<div style='font-size:8px;color:#A0A5AF;line-height:1.4;'>WH-LIM-01 leads at 18.6% breach with 441 late shipments. Review pick-and-pack SLAs and carrier handoff procedures at Lima warehouse.</div>" &
"</div>" &
"<div style='padding:9px 11px;background:#13161E;border-radius:5px;border-left:3px solid #2EC27E;display:flex;flex-direction:column;gap:3px;'>" &
"<div style='display:flex;align-items:center;gap:6px;'>" &
"<span style='background:#2EC27E;color:#13161E;font-size:8px;font-weight:700;padding:1px 6px;border-radius:2px;'>REC 04</span>" &
"<span style='font-size:8px;color:#A0A5AF;letter-spacing:1px;'>STRATEGIC</span>" &
"</div>" &
"<div style='font-size:10px;font-weight:700;color:#FFFFFF;'>Formalize carrier scorecards</div>" &
"<div style='font-size:8px;color:#A0A5AF;line-height:1.4;'>CondorShip &times; Colombia (13.8%) proves sub-15% is achievable. Introduce quarterly scorecards with penalty triggers at 18% breach threshold.</div>" &
"</div>" &
"<div style='padding:9px 11px;background:#13161E;border-radius:5px;border-left:3px solid #2EC27E;display:flex;flex-direction:column;gap:3px;'>" &
"<div style='display:flex;align-items:center;gap:6px;'>" &
"<span style='background:#2EC27E;color:#13161E;font-size:8px;font-weight:700;padding:1px 6px;border-radius:2px;'>REC 05</span>" &
"<span style='font-size:8px;color:#A0A5AF;letter-spacing:1px;'>STRATEGIC</span>" &
"</div>" &
"<div style='font-size:10px;font-weight:700;color:#FFFFFF;'>Implement SLA penalty pass-through</div>" &
"<div style='font-size:8px;color:#A0A5AF;line-height:1.4;'>~$45K recoverable if breach rate hits 10% target. Renegotiate carrier contracts to include client penalty pass-through clauses.</div>" &
"</div>" &
"</div>" &
"</div>"
formatString: @
displayFolder: 6. KPI Cards & Formatting

/// Composite header string for the top navigation bar. Combines period, delivery count, model version, and active date relationship. Drop into a Card visual in the header strip.

// ── 'Report Header Label' ──
measure 'Report Header Label' = [Period Label] & "  ·  " & FORMAT([Total Deliveries], "#,0") & " Deliveries  ·  Semantic Model v1.0  ·  Active Relationship: delivered_date"
formatString: @
displayFolder: 6. KPI Cards & Formatting

column placeholder
isHidden
isNameInferred
sourceColumn: [placeholder]

column delay_day_label
type: calculated
displayFolder: 6. KPI Cards & Formatting
summarizeBy: sum




// ================================================================
// (NO FOLDER)  (1 measures)
// ================================================================

// ── 'Cost Breakdown Value' ──
measure 'Cost Breakdown Value' =

SWITCH(
SELECTEDVALUE('Cost Breakdown Table'[Category]),
"Total Spend", [Total Shipping Cost],
"On-Time Cost", [Cost of On-Time Deliveries],
"Breach Cost", [Cost of SLA Breaches]
)


column Category
summarizeBy: none
isNameInferred
sourceColumn: [Category]


column SortOrder
formatString: 0
summarizeBy: sum
isNameInferred
sourceColumn: [SortOrder]


